# Telemetria de moto como servicio de systemd.
#
# NO arranca con el sistema (no se hace enable): se lanza a mano y sigue
# corriendo aunque cierres la sesion SSH, porque es un servicio del sistema.
#   sudo systemctl start telemetria     # arrancar
#   sudo systemctl stop telemetria      # parar (cierra la grabacion bien)
#   systemctl status telemetria
#   journalctl -u telemetria -f         # ver la salida
#
# Web por HTTPS (https://<ip>:8081/) con certificado autofirmado (./certs): en
# cada movil/portatil hay que abrirla una vez y aceptar el aviso. Asi la app
# publicada (https) puede conectar en vivo con la raspi.
#
# Lo instala systemd/instalar.sh, que cambia @DIR@ y @PYTHON@.

[Unit]
Description=Telemetria de moto (telemetria.py)
Wants=pigpiod.service network-online.target
After=pigpiod.service network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
# root: la tira WS2812 lo necesita
User=root
WorkingDirectory=@DIR@
ExecStart=@PYTHON@ -u @DIR@/telemetria.py --https
# telemetria.py convierte SIGTERM en una parada limpia (cierra CSV, LEDs, web)
KillSignal=SIGTERM
# al parar sube la ultima sesion al repo de datos (hasta 240 s; sin red, nada)
TimeoutStopSec=300
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
